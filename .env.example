# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wr_cursos
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/wr_cursos

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=your-mercado-pago-access-token
MERCADO_PAGO_PUBLIC_KEY=your-mercado-pago-public-key

# Email (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Storage S3-compatível (Cloudflare R2 / Backblaze B2 / MinIO / AWS S3)
# Exemplo R2: https://<accountid>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=wr-videos
STORAGE_REGION=auto
STORAGE_WATCH_URL_EXPIRATION=7200
