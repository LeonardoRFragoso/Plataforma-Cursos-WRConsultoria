# Development environment configuration template.
#
# Copy to .env and adjust as needed for local development.
# For production, see .env.production.example.

# ---- Environment ----
ENVIRONMENT=development

# ---- Database ----
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wr_cursos
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wr_cursos

# ---- JWT ----
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Tenant Secret Encryption ----
# Leave empty in development (falls back to deriving from SECRET_KEY).
# In production, generate with: openssl rand -base64 32
TENANT_SECRET_ENCRYPTION_KEY=

# ---- Mercado Pago ----
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_MOCK_MODE=false

# Provider-less PENDENTE attempts older than this may be replaced safely.
# Attempts that already created an external charge are never expired locally.
PAYMENT_PENDING_ATTEMPT_TTL_MINUTES=30

# ---- Email (SMTP) ----
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- CORS ----
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:5174"]

# ---- Allowed Hosts ----
ALLOWED_HOSTS=["*"]

# ---- SSO Central WR ----
CENTRAL_WR_FRONTEND_URL=http://localhost:5173
CENTRAL_WR_BACKEND_URL=http://localhost:8000
CENTRAL_WR_SSO_CLIENT_ID=lms-wr-cursos
CENTRAL_WR_SSO_CLIENT_SECRET=change-me-sso-secret

# ---- Frontend ----
VITE_API_URL=http://localhost:8000
VITE_CENTRAL_WR_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---- Rate Limiting ----
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Trusted Proxy ----
# Empty in development (use direct connection IP).
TRUSTED_PROXY_CIDRS=

# ---- API Docs ----
DOCS_ENABLED=true

# ---- Storage S3-compatível (Cloudflare R2 / Backblaze B2 / MinIO / AWS S3) ----
# STORAGE_BACKEND: "local" (development) or "s3" (production)
STORAGE_BACKEND=local
# Exemplo R2: https://<accountid>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=wr-videos
STORAGE_REGION=auto
STORAGE_WATCH_URL_EXPIRATION=7200
# Local storage directory (only used when STORAGE_BACKEND=local)
STORAGE_LOCAL_DIR=.local_storage
# Backend's own base URL (for building local upload/serve URLs)
API_BASE_URL=http://localhost:8000
