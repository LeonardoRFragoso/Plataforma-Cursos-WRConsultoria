# Production environment configuration template.
#
# Copy to .env.production and fill with real values.
# NEVER commit real secrets to the repository.
#
# The application will refuse to start in production mode if any
# critical setting is unsafe (placeholder, wildcard, empty, etc.).

# ---- Environment ----
ENVIRONMENT=production

# ---- Database ----
DB_USER=wr_app
DB_PASSWORD=CHANGE_ME_strong_password
DB_NAME=wr_cursos
DATABASE_URL=postgresql+asyncpg://wr_app:CHANGE_ME@postgres:5432/wr_cursos

# ---- Security ----
# JWT signing key. Must be >= 32 chars, random, not a placeholder.
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Encryption key for tenant secrets (AES-GCM, 32 bytes base64).
# Generate with: openssl rand -base64 32
# If lost, all encrypted tenant secrets become unrecoverable.
TENANT_SECRET_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# ---- Hosts / CORS ----
# Exact allowed Host headers (no wildcards).
ALLOWED_HOSTS=["api.example.com","app.example.com"]

# Exact allowed CORS origins (no wildcards, no localhost).
CORS_ORIGINS=["https://app.example.com"]

# ---- Frontend ----
FRONTEND_URL=https://app.example.com

# VITE_API_URL is a BUILD-TIME frontend configuration, NOT a runtime variable.
# Vite inlines import.meta.env.VITE_* into the compiled static bundle at build
# time. It is passed as a build argument to the web image (web/Dockerfile.prod)
# and interpolated by docker-compose.prod.yml under web.build.args.
#
# Changing the API URL requires REBUILDING the frontend image:
#   docker compose -f docker-compose.prod.yml build web
# Setting it as a runtime environment variable on the nginx container has NO
# effect — the value was already baked into the compiled JS.
#
# This is PUBLIC configuration, not a secret: every VITE_* value becomes
# browser-visible in the compiled JS. NEVER put credentials in a VITE_* variable.
#
# Staging build example:  VITE_API_URL=https://api.staging.example.com
# Production build:       VITE_API_URL=https://api.platform.example.com
VITE_API_URL=https://api.example.com

# ---- Rate Limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=redis://redis:6379/0
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Trusted Proxy ----
# CIDR of your reverse proxy/ingress. Only these IPs' X-Forwarded-For
# headers are trusted for client IP extraction.
# Empty = do not trust any forwarded IP.
TRUSTED_PROXY_CIDRS=10.0.0.0/8

# ---- API Docs ----
# Set to false to disable Swagger/OpenAPI in production.
DOCS_ENABLED=false

# ---- Mercado Pago ----
# MUST be false in production.
MERCADO_PAGO_MOCK_MODE=false
# Global MP credentials (fallback). Tenant-specific secrets stored in
# TenantSecret are authoritative. These are only used if a tenant has
# no secret configured.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=

# ---- Email (SMTP) ----
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password

# ---- Storage (S3-compatible) ----
# Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
# Backblaze B2: https://s3.<region>.backblazeb2.com
# AWS S3: https://s3.<region>.amazonaws.com
STORAGE_ENDPOINT=https://your-storage-endpoint.com
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_BUCKET=wr-videos
STORAGE_REGION=auto
STORAGE_WATCH_URL_EXPIRATION=7200

# ---- JWT ----
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Docker ports (optional, for reverse proxy mapping) ----
API_PORT=8000
WEB_PORT=80
